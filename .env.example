# =====================================================================
# ai-usage-dashboard — stack configuration
# Copy to .env and fill in. Never commit .env.
# Full onboarding guide: SUPPORT.md. Quick start: README.md.
# =====================================================================

# --- Required --------------------------------------------------------
# Shared secret between the collector and the server ingest endpoint.
# Any long random string, e.g.:  openssl rand -hex 32
INGEST_KEY=change-me

# --- Collector (required if you run the collector profile) -----------
# The ops user's home directory. The collector container mounts the
# credential subtree from here:
#   ~/.claude/.credentials.json            Claude OAuth (auto-refreshed)
#   ~/.config/opencode/auth.json           opencode auth (API keys + OAuth)
#   ~/.config/opencode/antigravity-accounts.json     Google AI / Antigravity
#   ~/.cache/opencode/packages/            companion auth plugin binaries
#   ~/.local/share/opencode/               opencode data dir
# Token refreshes WRITE BACK through the same mount: the host files stay
# the single source of truth for the interactive CLIs too (no copies, no
# split-brain).
CREDENTIALS_ROOT=/home/dave
#COLLECTOR_NAME=collector        # name shown in the ingest envelope

# --- Ports / binding (optional) ---------------------------------------
#DASHBOARD_PORT=8099             # server http port
#QWEN_UI_BIND=127.0.0.1          # qwen remote-desktop bind (LAN IP to expose)
#QWEN_UI_PORT=3099               # qwen remote-desktop port (https, self-signed)
#TZ=Europe/London                # container timezone (affects log times)

# --- Telegram alerts (optional; easiest via the Settings tab) ----------
# Create a bot with @BotFather, send it /start, then either use the
# Settings tab's "Send test message" button or set these here.
#AIUD_ALERT_ENABLED=true
#AIUD_ALERT_THRESHOLD=15         # percent remaining that triggers a message
#AIUD_TG_BOT_TOKEN=              # from @BotFather (Settings tab preferred)
#AIUD_TG_CHAT_ID=                # your chat id (Settings tab preferred)

# --- Qwen remote-desktop browser (only for --profile qwen) ------------
# Protects the browser desktop (published on your LAN). Log into the
# Alibaba ModelStudio console there once; the collector auto-grabs the
# session cookies over CDP from then on.
#QWEN_UI_USER=change-me
#QWEN_UI_PASSWORD=change-me

# --- Qwen / Alibaba Token Plan (optional) ------------------------------
# Token-plan API key — fallback "quota available" mode when no live
# console session is held in the qwen-browser container. Can also be set
# via the Settings tab.
#AIUD_QWEN_API_KEY=
