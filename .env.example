# Copy to .env and fill in. Never commit .env.
INGEST_KEY=change-me

# --- Collector overrides (optional) ---
# AIUD_AUTH_FILE=                 # path to opencode auth.json (default ~/.local/share/opencode/auth.json)
# AIUD_INGEST_URL=                # default http://127.0.0.1:8099/api/ingest
# AIUD_CLI_BIN=                   # path to opencode-quota binary (default ./scripts/node_modules/.bin/opencode-quota)
# AIUD_DASHBOARD_URL=             # URL included in Telegram alert messages (default http://localhost:8099)
# AIUD_COLLECTOR_NAME=            # name reported in the ingest envelope (default "collector")

# --- Qwen / Alibaba Token Plan (optional; can also be set via the Settings tab) ---
# AIUD_ALIBABA_COOKIE=            # console Cookie header from an api.json request (Copy as cURL)

# --- Telegram alerts (optional; can also be set via the Settings tab) ---
# AIUD_ALERT_ENABLED=true
# AIUD_ALERT_THRESHOLD=15         # percent remaining that triggers a message
# AIUD_TG_BOT_TOKEN=              # from @BotFather
# AIUD_TG_CHAT_ID=                # your chat id (message the bot first)